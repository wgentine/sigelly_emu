# Alfen Eve Pro Single (Modbus TCP source)
ALFEN_HOST=192.168.30.145
ALFEN_PORT=502
ALFEN_SLAVE_ID=1
ALFEN_POLL_INTERVAL=2.0
ALFEN_CONNECT_TIMEOUT=3.0

# Shelly Pro 3EM-3CT63 identity (model/fw match real SPEM-003CEBEU63)
SHELLY_DEVICE_ID=349454112233
SHELLY_MAC=34:94:54:11:22:33
SHELLY_MODEL=SPEM-003CEBEU63
SHELLY_FIRMWARE=2.0.0
SHELLY_FW_ID=20260710-101221/2.0.0-g87fbfa4
SHELLY_APP=Pro3EM
SHELLY_SN=EMU000001
# Leave empty for eth-only (matches working unit wifi.sta.ssid=null)
SHELLY_WIFI_SSID=
SHELLY_TZ=Europe/Amsterdam
SHELLY_LAT=52.3346
SHELLY_LON=4.8914
# false = integrate Wh from power (fresh meter); true = use Alfen lifetime energy
ALFEN_USE_ENERGY=false

# Network / service
HTTP_PORT=80
# Leave empty to auto-detect outbound LAN IP (required for mDNS)
SHELLY_ADVERTISE_IP=
MDNS_ENABLE=true
STATE_PATH=/data/state.json
LOG_LEVEL=INFO
